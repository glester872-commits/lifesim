{
  "permissions": {
    "deny": [
      "Bash(git clean)",
      "Bash(git clean *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git checkout .)",
      "Bash(git checkout -- *)",
      "Bash(git restore .)",
      "Bash(git restore -p)",
      "Bash(git restore -p *)",
      "Bash(git stash)",
      "Bash(git stash *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/settings.local.json)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git restore *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git rm *)",
      "Edit(.github/**)",
      "Edit(.gitignore)",
      "Edit(.claude/**)",
      "Edit(CLAUDE.md)",
      "Edit(AGENTS.md)",
      "Edit(package.json)",
      "Edit(scripts/agent-guard.mjs)",
      "Edit(scripts/autodev-gate.mjs)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agent-guard.mjs\" --policy=project",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
