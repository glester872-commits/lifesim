@@ -1,5 +1,6 @@
 import type Phaser from 'phaser';
 import { PALETTE } from '../config/constants';
+import { finishMaterialPixels, type MaterialFinish } from './MaterialFinish';
 
 /**
  * Primitivas de dibujo compartidas por TextureFactory, BuildingArt y PropArt.
@@ -44,13 +45,18 @@ export function glow(ctx: Ctx, cx: number, cy: number, radius: number, alpha: nu
   ctx.restore();
 }
 
-export function make(scene: Phaser.Scene, key: string, w: number, h: number, draw: (ctx: Ctx) => void): void {
+export function make(scene: Phaser.Scene, key: string, w: number, h: number, draw: (ctx: Ctx) => void, finish?: MaterialFinish): void {
   if (scene.textures.exists(key)) return;
   const texture = scene.textures.createCanvas(key, w, h);
   if (!texture) return;
   const ctx = texture.getContext();
   ctx.imageSmoothingEnabled = false;
   draw(ctx);
+  if (finish) {
+    const pixels = ctx.getImageData(0, 0, w, h);
+    finishMaterialPixels(pixels.data, w, h, finish);
+    ctx.putImageData(pixels, 0, 0);
+  }
   texture.refresh();
 }
 
